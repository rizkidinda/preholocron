        var eventVal = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allColEvent'); //mass input id : eventcount
        var eventRate = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allColRatePerEvent'); //mass input id : rateeventsell
        var projectedCost = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allProjectedCost'); //mass input id : projectedCost
        var estMonthlyRev = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allEstMonthlyRev'); //mass input id : estMonthlyRev
        var rateToCustVal = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allColRateToCust'); //mass input id : rateToCust
        var montVolVal = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allMVol'); //mass input id : monthlyVol
        var noOfAPICallVal = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allAPICall'); //mass input id : noOfAPICall
        var rateAPICallVal = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:input_allRateAPICall'); //mass input id : rateAPICall
        
        if(typeof (keyCol) != 'undefined' && keyCol != null && typeof (prodFam) != 'undefined' && prodFam != null){
            
            massUpdateField(subAccountVal, 'numberofsubaccount', prodFam, keyCol);
            massUpdateField(rateSubAccountVal, 'subaccsell', prodFam, keyCol);
            massUpdateField(fixedRateVal, 'fixedratesell', prodFam, keyCol);
            massUpdateField(tpvVal, 'estimatedtpv', prodFam, keyCol);
            massUpdateField(tpvRate, 'ratetpvsell', prodFam, keyCol);
            massUpdateField(basketSize, 'inputbasketsize', prodFam, keyCol);
            massUpdateField(txnRate, 'ratetxnsell', prodFam, keyCol);
            massUpdateField(eventVal, 'eventcount', prodFam, keyCol);
            massUpdateField(eventRate, 'rateeventsell', prodFam, keyCol);
            massUpdateField(projectedCost, 'projectedCost', prodFam, keyCol);
            massUpdateField(estMonthlyRev, 'estMonthlyRev', prodFam, keyCol);
            massUpdateField(rateToCustVal, 'rateToCust', prodFam, keyCol);
            massUpdateField(montVolVal, 'monthlyVol', prodFam, keyCol);
            massUpdateField(noOfAPICallVal, 'noOfAPICall', prodFam, keyCol);
            massUpdateField(rateAPICallVal, 'rateAPICall', prodFam, keyCol);

            refreshAllCalcFields();
        }
    }

    function massUpdateField(inputField, outputFieldId, countPrdFam, keyCol){
        console.log('go to massUpdateField');
        if(inputField && inputField.value.length > 0){
            for(i = 0 ; i < countPrdFam.value; i++){
                var inputVal = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + i + ':' + outputFieldId);
                if(typeof (inputVal) != 'undefined' && inputVal != null){
                    inputVal.value = inputField.value;
                    console.log('massUpdateField ' + outputFieldId + ' value : ' );
                    console.log(inputVal.value);
                }
            }
        }
    }

    // refresh all notes
    function refreshAllNotes()
    {
        console.log('go to refreshAllNotes');
        var maksKeyCol = document.getElementById('maxKeyCol').value;
        for(j = 0 ; j < maksKeyCol; j++){
            var maks = document.getElementById(PREFIX1 + ':' + j + ':pb2:pbsitem:maxRow');
            if(typeof (maks) != 'undefined' && maks != null){
                for(i = 0; i < maks.value; i++) {
                    refreshNotes(j,i);
                }
            }
        }
    }

    // refresh all calculation field
    function refreshAllCalcFields()
    {
        console.log('go to refreshAllCalcFields');
        var maksKeyCol = document.getElementById('maxKeyCol').value;
        for(j = 0 ; j < maksKeyCol; j++){
            var maks = document.getElementById(PREFIX1 + ':' + j + ':pb2:pbsitem:maxRow');
