<apex:page docType="html-5.0" lightningStylesheets="true" controller="OppItemController" action="{!init}" id="pg" title="Opportunity - Add/Edit Products" >
    <style>
        .input_num {
        	width:100px;
        	text-align:right;
        }
        .tableheader, .tableheader div {
        	white-space: normal;
            vertical-align: top;
        }
        .width8Rem, .width8Rem div {
            min-width:8rem;
        }
        .msgBox {
        	width:400px;
        	margin:10px auto;
        	text-align:center;
        	z-index: 500;
        	position:fixed;
        	left: calc((100%/2) - 200px);
        	top: 150px;
        }
        .msgBox a, .msgBox a:hover, .msgBox a:active {
        	color: white;
        }
        .msgBox div {
        	padding: 10px;
        }
        .msgBox .close {
            color:white:
            font-weight:bold;
            float:right;
            margin:-5px 5px;
            font-size:20px;
        }
        .notes {
        	font-weight: bold;
        }

        .headerTitle {
            display : inline-block;
            vertical-align : middle;
            height : 100% !important;
            width : fit-content;
            max-width : 80%;
            white-space: break-spaces;
        }

        .displayNone {
            display : none;
        }

        .tooltipIcon{
            display : inline-block;
            vertical-align : middle;
            background-size : cover;
            width : 15px;
            margin-left : 2px;
            background-image: url("/servlet/servlet.FileDownload?file=0150p000000RQou"); //to update
        }   

        .panel {
            padding: 0 18px;
            display: none;
            background-color: white;
            overflow: hidden;
        }
    </style>
    <apex:sectionHeader title="OPPORTUNITY - {!objOpp.Name}{!IF(objOpp.Account.Is_Reseller__c,' (Reseller Account)',' (Non-Reseller Account)')}"
                        subtitle="Close Date: {!objOpp.CloseDate}, 
                                  Amount:  {!objOpp.CurrencyIsoCode} {!oppAmount},  
                                  Type : {!objOpp.Type}, 
                                  Stage: {!objOpp.StageName},
                                  Is Reseller : {!objOpp.Account.Is_Reseller__c} " />
    <apex:form id="mainform" >
    <apex:actionStatus id="loadingstatus">
        <apex:facet name="start">
            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; opacity: 0.25; z-index: 1000; background-color: black;">
                &nbsp;
            </div>
            <div style="position: fixed; left: 0; top: 0; bottom: 0; right: 0; z-index: 1001; margin: 15% 50%">
                <div style="display: inline-block; background-color: #fff; opacity: 0.7; width: 125px;">
                    <img src="/img/loading.gif" style="float: left; margin: 10px;" />
                    <span style="display: inline-block;padding: 10px 0px;">Please Wait...</span>
                </div>
            </div>
        </apex:facet>
    </apex:actionStatus>
    <apex:outputPanel id="panelErrorMsg">
        <apex:outputText rendered="{!strErrorMsg != ''}" id="outputTextError">
            <div id="msgError" style="border:1px solid red;" class="msgBox">
                <div style="color:white;background-color:red;border-bottom:1px solid red;">
                    <b>ERROR</b>
                    <a class="close" href="#" style="" onclick="document.getElementById('msgError').style.display = 'none';">&times;</a>
                </div>
                <div style="background-color:white;" class="">
                  {!strErrorMsg}
                </div>
            </div>
        </apex:outputText>
    </apex:outputPanel>
    <apex:outputPanel id="panelSuccessMsg">
        <apex:outputText rendered="{!strSuccessMsg != ''}" id="outputTextSuccess">
            <div id="msgSuccess" style="border:1px solid green;" class="msgBox">
                <div style="color:white;background-color:green;border-bottom:1px solid green;">
                    <b>SUCCESS</b>
                    <a class="close" href="#" style="" onclick="document.getElementById('msgSuccess').style.display = 'none';">&times;</a>
                </div>
                <div style="background-color:white;">
                  {!strSuccessMsg}
                </div>
            </div>
        </apex:outputText>
    </apex:outputPanel>
    <apex:pageBlock id="mainblock" >
        <!-- HACK: Fake pbSection to inject the twistSection JS function -->
        <apex:pageBlockSection title="Test" showHeader="true" rendered="false">
            <apex:pageBlockSectionItem >
                <apex:outputText value="Label" />
                <apex:outputText value="Value" />
            </apex:pageBlockSectionItem>
        </apex:pageBlockSection>
        
        <apex:outputText escape="false" value="{!allHelptext}">
        </apex:outputText>
        <apex:outputText escape="false" rendered="{!IsParentLocked != ''}">
            <div style="text-align:center; padding-bottom:10px;font-weight:bold;color:red;">
                {!IsParentLocked}
            </div>
        </apex:outputText>
        <apex:pageBlockButtons >
            <apex:outputPanel id="panelBtn">
                    <apex:commandButton value="Pricing Playbook" title="Click here to see pricing playbook" rendered="{!showType = showOPP && bolEditable}" id="btn-pricing-table" onclick="openPricingTableURL(event); return false;" />
                    <apex:commandButton value="Edit Pricebook" rendered="{!oppProductCount = 0 && showType = showOPP && bolEditable}" id="btn-show-pricebook" action="{!showEditPricebook}" />
                    <apex:commandButton value="Save Pricebook" rendered="{!showType = showPB && bolEditable}" id="btn-save-pricebook" action="{!savePricebook}" />
                    <apex:commandButton value="Add Selected Products" rendered="{!showType = showPRD && bolEditable}" id="btn-add" action="{!addProducts}" reRender="mainform" status="loadingstatus" oncomplete="refreshAllCalcFields();"/>
                    <apex:commandButton value="Cancel" rendered="{!showType = showPRD && bolEditable}" id="btn-cancel-add" action="{!hideProductList}" immediate="true" />
                    <apex:commandButton value="Add Products" rendered="{!showType = showOPP && bolEditable}" id="btn-new-items" action="{!showProductList}" />
                    <apex:commandButton value="Save" title="Save changes on opportunity products" rendered="{!showType = showOPP && bolEditable}" id="btn-save-items" action="{!saveProducts}" reRender="mainform" status="loadingstatus" oncomplete="refreshAllCalcFields();"/>
                    <apex:commandButton value="Delete Selected" title="Delete selected opportunity products" rendered="{!showType = showOPP && oppProductCount > 0 && bolEditable}" id="btn-del-items" action="{!deleteProducts}" reRender="mainform" status="loadingstatus" oncomplete="refreshAllCalcFields();"/>
                    <apex:commandButton value="Back to Opportunity" action="{!back}" immediate="true" />
            </apex:outputPanel>
        </apex:pageBlockButtons>
        <apex:pageBlockSection rendered="{!showType = showPB}" columns="1" collapsible="false"  title="Please update Pricebook" >
            <apex:inputField required="true" value="{!objOpp.Xendit_Price_Book__c}" />
        </apex:pageBlockSection>
        
        <apex:outputPanel id="panelShowPRD">
            <apex:pageBlockSection rendered="{!showType = showPRD}" columns="1" collapsible="false" id="productslist" title="Search Products" >    
                <apex:variable value="{!0}" var="famCol" />
                <apex:repeat value="{!ProductFamilySet}" var="Key" id="ratecardRepeat">
                    <apex:pageBlockSection collapsible="true" title="{!Key}" id="pb" columns="1">
                        <apex:pageBlockSectionItem id="ratepbsitem">
                            <apex:outputpanel id="prodFamPanel">
                                <apex:variable value="{!0}" var="famRow" />
                                <apex:inputCheckbox id="selectAllFlag" onchange="updateSelectAllProductFlag({!famCol})"/>
                                <apex:outputLabel value="Select All" style="color : rgb(3, 45, 96);font-size : 13px" for="selectAllFlag"/>
                                <p>&nbsp;</p>
                                <apex:pageBlockTable value="{!arrRateMap[Key]}" var="r" id="ratecardtable">
                                    <apex:column title="{!r.Notes}">
                                        <apex:inputCheckbox id="productFlag" value="{!r.isSelected}" rendered="{!r.isDisabled = false}" onchange="updateRatecardFlag({!famCol})"></apex:inputCheckbox>
                                    </apex:column>
                                    <apex:column value="{!r.P.Name}"/>
                                    <apex:column value="{!r.R.Brand__c}"/>
                                    <apex:column value="{!r.R.Description__c}"/>
                                    <apex:column headerValue="Fixed Spread for Xendit rate (BPS)" value="{!r.R.Xendit_Rate_BPS__c}" rendered="{!Key == 'Remittance FX' || Key == 'Cross Border PG FX'}"/>
                                    <apex:column headerValue="Rate per Txn" value="{!r.R.Rate_Per_Txn__c}" rendered="{!Key != 'Remittance FX' && Key != 'Cross Border PG FX'}"/>
                                    <apex:column headerValue="Rate per Tpv" value="{!r.R.Rate_Per_TPV__c}" rendered="{!Key != 'Remittance FX' && Key != 'Cross Border PG FX'}"/>
                                    
                                    <apex:column headerValue="Remarks/Not selectable reason" style="width : 20%">
                                        <apex:outputText value="{!r.Notes}" />
                                        <apex:variable value="{!famRow + 1}" var="famRow" />
                                    </apex:column>
                                    
                                </apex:pageBlockTable>
                                <apex:inputHidden id="maxFamRow" value="{!productFamilyMap[Key]}" />
                            </apex:outputpanel>
                            
                        </apex:pageBlockSectionItem>
                        <script> twistSection(document.getElementById('{!$Component.pb}').childNodes[0].childNodes[0]) </script>
                    </apex:pageBlockSection>
                    <apex:variable value="{!famCol + 1}" var="famCol" />
                </apex:repeat>
            </apex:pageBlockSection>
        </apex:outputPanel>
                    
                    
        <apex:outputPanel id="panelShowOpp">
            <apex:pageBlockSection rendered="{!showType = showOPP}" columns="1" collapsible="false" title="Opportunity Products" id="itemsection" >
                <apex:variable value="{!0}" var="keyCol" />
                <apex:repeat value="{!xOppProductFamilySet}" var="Key" id="productRepeat">
                    <apex:pageBlockSection collapsible="true" title="{!Key}" id="pb2" columns="1">
                        <apex:pageBlockSectionItem id="pbsitem">
                            <apex:outputpanel >
                                <apex:variable value="{!0}" var="fRow" />
                                <apex:pageBlockTable value="{!arrOppProductsMap[Key]}" var="item" id="itemtable">
                                    <apex:column >
                                        <apex:inputCheckbox value="{!item.isSelected}"></apex:inputCheckbox>
                                    </apex:column>
                                    <apex:column headerValue="" headerClass="tableheader">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                            <table>
                                                <tr style="height:80px !important; ">
                                                    <td style="min-width: 100px !important; border:none !important;">
                                                        <apex:outputText styleClass="headerTitle" value="Name"/>
                                                        <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Product2.fields.Name.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Product2.fields.Name.InlineHelpText))}"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="width=100%; border:none !important;" >
                                                        <apex:commandButton value="Apply All" id="btn-apply-all" onclick="applyAll({!keyCol})" onComplete="return false;"/>
                                                    </td>
                                                </tr>
                                            </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:outputField value="{!item.P.Name}" />
                                    </apex:column>
                                        
                                    <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showFXProduct}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Brand"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:outputText value="{!item.XP.Rate_Card__r.Brand__c}" styleClass="" />
                                    </apex:column>     
                                        
                                    <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showDescription}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Description"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Rate_Card__c.fields.Description__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Rate_Card__c.fields.Description__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:outputField value="{!item.XP.Rate_Card__r.Description__c}" />
                                    </apex:column>
                                      <apex:column headerValue="" headerClass="tableheader" >
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Currency"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.CurrencyIsoCode.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.CurrencyIsoCode.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:outputField value="{!item.XP.CurrencyIsoCode}" rendered="{!NOT(prodFamMap[Key].showFXProduct)}"/>
                                        <apex:outputField value="{!item.XP.Rate_Card__r.CurrencyIsoCode}" rendered="{!prodFamMap[Key].showFXProduct}"/>
                                    </apex:column>  
                                        
                                    //------------------------TRIAL VAS Subscription
                                     <apex:column headerClass="tableheader width8Rem" headerValue="">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Tier Structure"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.Tier_Structure__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.Tier_Structure__c.InlineHelpText))}"/>
														</td>
                                                    </tr>
                                                    <tr>
                                                       <td style="width=100%; border:none !important;" >
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                </table>
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:inputField value="{!item.XP.Tier_Structure__c}" id="tierStructure" />
                                    </apex:column>
                                   
                                    //-----------------------VAS PRODUCT-----------------
                                    <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showVASProduct}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="No of API Calls"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.No_of_API_Calls__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.No_of_API_Calls__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            <apex:inputField id="input_allAPICall" value="{!prodFamMap[Key].applyAllVal.No_of_API_Calls__c}"/>
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:inputField value="{!item.XP.No_of_API_Calls__c}" styleClass="width:100%; text-align:right;" id="noOfAPICall" />
                                    </apex:column>

                                    <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showVASProduct}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Rate per API Call"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.Rate_per_API_Call__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.Rate_per_API_Call__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            <apex:inputField id="input_allRateAPICall" value="{!prodFamMap[Key].applyAllVal.Rate_per_API_Call__c}"/>
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:inputField value="{!item.XP.Rate_per_API_Call__c}" styleClass="width:100%; text-align:right;" id="rateAPICall" />
                                    </apex:column>

                                        
                                    //-----------------------FX PRODUCT-----------------
                                     
                                    <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showFXProduct}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Fixed Spread for Xendit rate (BPS)"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.Xendit_Rate_BPS__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.Xendit_Rate_BPS__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:outputText value="{!item.XP.Xendit_Rate_BPS__c}" style="width:100%; text-align:right;" />
                                    </apex:column>
                                        
                                     <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showFXProduct}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Rate to customer (BPS)"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.Rate_to_customer_BPS__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.Xendit_Rate_BPS__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            <apex:inputField id="input_allColRateToCust" value="{!prodFamMap[Key].applyAllVal.Rate_to_customer_BPS__c}"/>
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:inputField value="{!item.XP.Rate_to_customer_BPS__c}" styleClass="width:100%; text-align:right;" onchange="refreshNotes({!keyCol},{!fRow})" id="rateToCust" />
                                    </apex:column>

                                   <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showFXProduct}" >
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Margin (BPS)"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.Margin_BPS__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.Margin_BPS__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:outputText value="{!item.XP.Margin_BPS__c}" style="width:100%; text-align:right;"/>
                                    </apex:column>     
                                   
                                        
                                    <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showFXProduct}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Expected Monthly Volume"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.Expected_Monthly_Volume__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.Expected_Monthly_Volume__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            <apex:inputField id="input_allMVol" value="{!prodFamMap[Key].applyAllVal.Expected_Monthly_Volume__c}"/>
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:inputField value="{!item.XP.Expected_Monthly_Volume__c}" style="width=100%; !important; text-align:right;" id="monthlyVol"/>
                                    </apex:column>
                                        
                                    <apex:column headerValue="" headerClass="tableheader" rendered="{!prodFamMap[Key].showProductLabel}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
                                                        <td style="width : 100%; border:none !important;">
                                                            <apex:outputText styleClass="headerTitle" value="Product Label"/>
                                                            <apex:image styleClass="tooltipIcon" value="/s.gif" title="{!$ObjectType.Xendit_Opportunity_Product__c.fields.Product_Label__c.InlineHelpText}" rendered="{!NOT(ISBLANK($ObjectType.Xendit_Opportunity_Product__c.fields.Product_Label__c.InlineHelpText))}"/>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="width=100%; border:none !important;" >
                                                            &nbsp;
                                                        </td>
                                                    </tr>
                                                </table> 
                                            </apex:outputPanel>
                                        </apex:facet>
                                        <apex:inputField value="{!item.XP.Product_Label__c}" styleClass="" />
                                    </apex:column>
                                        
                                   
                                    <apex:column headerValue="" headerClass="tableheader" styleClass="input_num" rendered="{!prodFamMap[Key].showProjectedCost}">
                                        <apex:facet name="header">
                                            <apex:outputPanel style="display : inline-block; width : 100%">
                                                <table>
                                                    <tr style="height:80px !important">
