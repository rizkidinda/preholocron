    function parseStringtoFloat(data){
        var tempData = data.toString();
        var temp = (tempData.replaceAll(',', ''));
        var returnVal = parseFloat(temp);
        return returnVal;
    }

    function updateBasketSize(keyCol,iRow){
        console.log('go to updateBasketSize')
        var objBasketSize = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':inputbasketsize');
        var objcalcThreshold = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':calcThreshold');
        var objcalcSelectionType = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':calcSelectionType');
        var objselectedFieldForHigherThreshold = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':selectedFieldForHigherThreshold');
        var objMDRSell = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':ratetpvsell');
        var objRateTxnSell = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':ratetxnsell');
        
        if (typeof (objBasketSize) != 'undefined' && objBasketSize != null && 
            typeof (objcalcThreshold) != 'undefined' && objcalcThreshold != null &&
            typeof (objselectedFieldForHigherThreshold) != 'undefined' && objselectedFieldForHigherThreshold != null
        ) {
            console.log('testing 123');
            console.log(objBasketSize.value);
            console.log(parseStringtoFloat(objBasketSize.value));
            console.log(objcalcThreshold.value);
            console.log(objselectedFieldForHigherThreshold.value);
            if((parseStringtoFloat(objBasketSize.value) > parseStringtoFloat(objcalcThreshold.value) && objselectedFieldForHigherThreshold.value == 'RatePerTxn') ||
                                    (parseStringtoFloat(objBasketSize.value) <= parseStringtoFloat(objcalcThreshold.value) && objselectedFieldForHigherThreshold.value == 'MDR')){
                                        console.log('updateBasketSize IF');
                                        objRateTxnSell.disabled = false;
                                        objMDRSell.disabled = true;

            }else if((parseStringtoFloat(objBasketSize.value) > parseStringtoFloat(objcalcThreshold.value) && objselectedFieldForHigherThreshold.value == 'MDR') ||
                                    (parseStringtoFloat(objBasketSize.value) <= parseStringtoFloat(objcalcThreshold.value) && objselectedFieldForHigherThreshold.value == 'RatePerTxn')){
                                       console.log('updateBasketSize ELSE IF');
                                        objMDRSell.disabled = false;
                                        objRateTxnSell.disabled = true;

            }else{
                console.log('opt 2');
                refreshTPVandRevenueFields(keyCol,iRow);
            }

        }else{
            console.log('opt 3');
            refreshTPVandRevenueFields(keyCol,iRow);
        }
    }
    
    //refresh TPV & Revenue fields
    function refreshTPVandRevenueFields(keyCol,iRow){
        console.log('go to refreshTPVandRevenueFields');
        var objMDRSell = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':ratetpvsell');
        var objRateTxnSell = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:itemtable:' + iRow + ':ratetxnsell');

        if(typeof (objMDRSell) != 'undefined' && objMDRSell != null){
            objMDRSell.disabled = false;
            console.log('MDR disabled');
        }
        
        if(typeof (objRateTxnSell) != 'undefined' && objRateTxnSell != null){
            objRateTxnSell.disabled = false;
            console.log('Txn disabled');
        }

        console.log('refreshTPVandRevenueFields after');
        
    }

    function updateSelectAllProductFlag(keyCol){
        var objFlag = document.getElementById(PREFIX2 + ':' + keyCol + ':pb:ratepbsitem:selectAllFlag');
        var countRateCard = document.getElementById(PREFIX2 + ':' + keyCol + ':pb:ratepbsitem:maxFamRow');
        if(typeof (objFlag) != 'undefined' && objFlag != null && typeof (countRateCard) != 'undefined' && countRateCard != null){
            for(i = 0 ; i < countRateCard.value; i++){
                var rateFlag = document.getElementById(PREFIX2 + ':' + keyCol + ':pb:ratepbsitem:ratecardtable:' + i + ':productFlag');
                if(typeof (rateFlag) != 'undefined' && rateFlag != null){
                    rateFlag.checked = objFlag.checked;
                }
            }   
        }
    }

    function updateRatecardFlag(keyCol){
        var objFlag = document.getElementById(PREFIX2 + ':' + keyCol + ':pb:ratepbsitem:selectAllFlag');
        var countRateCard = document.getElementById(PREFIX2 + ':' + keyCol + ':pb:ratepbsitem:maxFamRow');
        if(typeof (objFlag) != 'undefined' && objFlag != null && typeof (countRateCard) != 'undefined' && countRateCard != null){
            objFlag.checked = true;
            for(i = 0 ; i < countRateCard.value; i++){
                var rateFlag = document.getElementById(PREFIX2 + ':' + keyCol + ':pb:ratepbsitem:ratecardtable:' + i + ':productFlag');
                if(typeof (rateFlag) != 'undefined' && rateFlag != null){
                    console.log('rateFlag checked : ' + rateFlag.checked);
                    if(!rateFlag.checked){
                        objFlag.checked = false;
                    }
                    
                }
                console.log('object flag checked : ' + objFlag.checked);
            }   
        }
    }

    function applyAll(keyCol){
        console.log('applyAll key : ' + keyCol);
        var prodFam = document.getElementById(PREFIX1 + ':' + keyCol + ':pb2:pbsitem:maxRow'); //to get number of opp item for each product family
