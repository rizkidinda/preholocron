                for(i = 0; i < maks.value; i++) {
                    updateBasketSize(j,i);
                }
            }
        }
    }

    function openPricingTableURL(event){
        event.preventDefault();
        var linkURL = "{!$Label.Pricing_Table_Link}";
        window.open(linkURL,"_blank");
    }

