<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>false</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>RecordType</field>
        <field>Opportunity__c</field>
        <field>Justification2__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>adhoc</type>
            </approver>
        </assignedApprover>
        <description>PH Risk Approval</description>
        <entryCriteria>
            <criteriaItems>
                <field>Opportunity.Risk_Category__c</field>
                <operation>notEqual</operation>
                <value>Prohibited</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>RejectRecord</ifCriteriaNotMet>
        <label>PH Risk Approval</label>
        <name>PH_Risk_Approval</name>
    </approvalStep>
    <description>Opportunity PH Risk Approval Process</description>
    <emailTemplate>Xendit_Approval_Email_Templates/Opportunity_Risk_Approval_Submission_Template</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity_Approval__c.RecordType</field>
            <operation>equals</operation>
            <value>Risk Approval</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Risk_Category__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Risk_Category__c</field>
            <operation>notEqual</operation>
            <value>Moderate</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Country_of_HQ__c</field>
            <operation>equals</operation>
            <value>Philippines</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Opportunity_Risk_Approval_Approved_Alert</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_as_Approved</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Opportunity_Risk_Approval_Rejected_Alert</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Status_as_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Status_as_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Opportunity PH Risk Approval Process</label>
    <processOrder>3</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
