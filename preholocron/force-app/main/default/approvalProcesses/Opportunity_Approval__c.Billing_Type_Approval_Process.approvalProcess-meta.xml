<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>RecordType</field>
        <field>Opportunity__c</field>
        <field>Justification2__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>L1_Manager__c</name>
                <type>relatedUserField</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <formula>!ISNULL(Opportunity__r.Billing_Type_Approval_Level__c) &amp;&amp; (Opportunity__r.Billing_Type_Approval_Level__c = 1 || (Opportunity__r.Billing_Type_Approval_Level__c &gt; 1 &amp;&amp;  Opportunity__r.Need_L1_Billing_Type_Approval__c) ) &amp;&amp;  
( ISNULL(Opportunity__r.Pricing_Approver_Level__c) || Opportunity__r.Pricing_Approver_Level__c &lt; 1 ) &amp;&amp;
 !ISBLANK(L1_Manager__c)</formula>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>L1 Manager Approval</label>
        <name>L1_Manager_Approval</name>
        <rejectionActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>joshua.lau@xendit.co</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Direct Billing (excl Standard) &amp; Indirect Billing</description>
        <entryCriteria>
            <formula>!ISNULL(Opportunity__r.Billing_Type_Approval_Level__c) &amp;&amp; (Opportunity__r.Billing_Type_Approval_Level__c == 1 || (Opportunity__r.Billing_Type_Approval_Level__c &gt;1 &amp;&amp;  Opportunity__r.Need_L1_Billing_Type_Approval__c ))</formula>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Billing Manager Approval</label>
        <name>Billing_Manager_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>fah@xendit.co</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>Manual Billing w/ Pricing Approval  below level 3</description>
        <entryCriteria>
            <formula>!ISNULL(Opportunity__r.Opp_Product_with_Manual_Billing__c) &amp;&amp; Opportunity__r.Opp_Product_with_Manual_Billing__c &gt; 0 &amp;&amp;
(!ISNULL( Opportunity__r.Pricing_Approver_Level__c ) &amp;&amp; Opportunity__r.Pricing_Approver_Level__c &lt; 3)</formula>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Fah Approval</label>
        <name>Fah_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>darrick@xendit.co</name>
                <type>user</type>
            </approver>
            <approver>
                <name>dexter.leong@xendit.co</name>
                <type>user</type>
            </approver>
            <approver>
                <name>joshua.lau@xendit.co</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>Unanimous</whenMultipleApprovers>
        </assignedApprover>
        <description>Manual Billing</description>
        <entryCriteria>
            <formula>!ISNULL(Opportunity__r.Opp_Product_with_Manual_Billing__c) &amp;&amp; Opportunity__r.Opp_Product_with_Manual_Billing__c &gt; 0</formula>
        </entryCriteria>
        <label>Manual Billing</label>
        <name>Steven_manual_billing_approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Reset_Update_History</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_Approval_Step_0</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>Xendit_Approval_Email_Templates/Pricing_Approval_Submission</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>NOT(ISPICKVAL(Status__c,&quot;Approved&quot;)) &amp;&amp;
RecordType.Name = &apos;Pricing Approval&apos; &amp;&amp;
ISBLANK(Opportunity__r.Parent_Opportunity__c) &amp;&amp;
Billing_Type_Approved__c = FALSE &amp;&amp;
(

(!ISNULL(Opportunity__r.Billing_Type_Approval_Level__c) &amp;&amp; Opportunity__r.Billing_Type_Approval_Level__c &gt; 0) ||
(!ISNULL(Opportunity__r.Opp_Product_with_Manual_Billing__c) &amp;&amp; Opportunity__r.Opp_Product_with_Manual_Billing__c &gt; 0)
)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Opportunity_Billing_Type_TRUE</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Opportunity_Billing_Type_FALSE</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_as_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Reset_Approval_History</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Reset_Approval_Step</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_as_Submitted</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Billing Type Approval Process</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Opportunity_Billing_Type_FALSE</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Status_as_Recalled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
