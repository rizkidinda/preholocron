    <emailTemplate>Xendit_Approval_Email_Templates/Pricing_Approval_Submission</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <formula>NOT(ISPICKVAL(Status__c,&quot;Approved&quot;)) &amp;&amp;
IF((NOT ISPICKVAL(Opportunity__r.FX_Product_Approval__c, &apos;Not Approval Required&apos;)) &amp;&amp; Is_Recalled__c = TRUE, FALSE, TRUE) &amp;&amp;
RecordType.Name = &apos;Pricing Approval&apos; &amp;&amp;
CONTAINS( Opportunity__r.Owner.UserRole.Name , &apos;PH&apos;) &amp;&amp;
ISBLANK(Opportunity__r.Parent_Opportunity__c) &amp;&amp;
(Billing_Type_Approved__c = TRUE ||  ISNULL(Opportunity__r.Billing_Type_Approval_Level__c) || Opportunity__r.Billing_Type_Approval_Level__c = 0 ) &amp;&amp;
(!ISNULL(Opportunity__r.Pricing_Approver_Level__c) &amp;&amp; Opportunity__r.Pricing_Approver_Level__c &gt; 0) &amp;&amp;
(!ISNULL(Opportunity__r.Opp_Product_Below_COGS_Count__c) &amp;&amp; Opportunity__r.Opp_Product_Below_COGS_Count__c &gt; 0 &amp;&amp; Opportunity__r.Addressable_Monthly_Profitability__c &lt; 0)</formula>
    </entryCriteria>
    <finalApprovalActions>
        <action>
