    <formulas>
        <name>AccountLeadOwner</name>
        <dataType>String</dataType>
        <expression>IF(OR(LEFT({!$Record__Prior.OwnerId},3) = &quot;00G&quot;, LEFT({!$Record.OwnerId},3) = &quot;00G&quot;) , {!$User.Id} , {!$Record.OwnerId} )</expression>
    </formulas>
    <formulas>
        <name>AssignedToId</name>
        <dataType>String</dataType>
        <expression>IF(OR(BEGINS({!$Record.OwnerId},&apos;00G&apos;), AND(BEGINS({!$Record.OwnerId},&apos;005&apos;),{!$Record.Owner:User.IsActive} = FALSE)),{!$User.Id},{!$Record.OwnerId})</expression>
    </formulas>
    <formulas>
        <name>CloseDate</name>
        <dataType>Date</dataType>
