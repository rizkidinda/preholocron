    <description>Update the lead owner on an inbound lead when there is no mapped referral code value</description>
    <environments>Default</environments>
    <formulas>
        <name>BDOwnerFormula</name>
        <dataType>String</dataType>
        <expression>IF(({!$UserRole.DeveloperName}= &quot;ID_BDR_Role&quot; || {!$UserRole.DeveloperName}= &quot;PH_BDR_Role&quot;),CASESAFEID({!$User.Id}),null)</expression>
    </formulas>
    <formulas>
        <name>IsNewFormula</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>LeadXenditAccEmail</name>
        <dataType>String</dataType>
        <expression>IF(AND(ISBLANK({!$Record.Xendit_Account_Email__c}), !ISBLANK({!$Record.Email})),{!$Record.Email},{!$Record.Xendit_Account_Email__c})</expression>
    </formulas>
    <formulas>
        <name>prior_referralCode</name>
        <dataType>String</dataType>
        <expression>LOWER({!$Record__Prior.Referral_Code__c})</expression>
    </formulas>
    <formulas>
        <name>refferalCode</name>
        <dataType>String</dataType>
        <expression>LOWER({!$Record.Referral_Code__c})</expression>
    </formulas>
    <formulas>
        <name>TodayFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY ()</expression>
    </formulas>
