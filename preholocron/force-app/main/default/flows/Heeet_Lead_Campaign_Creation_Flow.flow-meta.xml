    <decisions>
        <description>Check when the lead is created, and the lead field “Heeet__Heeet_First_Click_Campaign_Name__c“ is not blank, then get the campaign record that match with the value of Heeet__Heeet_First_Click_Campaign_Name__c.

if not found, do nothing.

then add the lead to the campaign as a campaign member, with status = Tactic Engaged</description>
        <name>Check_Campaign</name>
        <label>Check Campaign</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>First_Click</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Heeet__Heeet_First_Click_Campaign_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Heeet__Heeet_First_Click_Campaign_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.First_Interaction_UTM_Category__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Initial_Assignment</targetReference>
            </connector>
            <label>First Click UTM</label>
        </rules>
        <rules>
            <name>Last_Click</name>
            <conditionLogic>(1 OR 2) AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Heeet__Heeet_Google_Campaign_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Heeet__Heeet_Google_Campaign_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>isNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Last_Interaction_UTM_Category__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Initial_Assignment</targetReference>
            </connector>
            <label>Last Click UTM</label>
        </rules>
        <rules>
            <name>Same_Campaign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Heeet__Heeet_First_Click_Campaign_Name__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Heeet__Heeet_Google_Campaign_Name__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Campaign_Name1</targetReference>
            </connector>
            <label>Same Campaign</label>
        </rules>
        <rules>
            <name>Different_Campaign</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Heeet__Heeet_First_Click_Campaign_Name__c</leftValueReference>
                <operator>NotEqualTo</operator>
