    <formulas>
        <name>AccCustomerFolderURL</name>
        <dataType>String</dataType>
        <expression>IF(
  NOT(ISBLANK({!get_Account.Customer_Folder_URL__c})),
 {!get_Account.Customer_Folder_URL__c},
  &apos;n/a&apos;
)</expression>
    </formulas>
    <formulas>
        <name>AccountLeadOwner</name>
        <dataType>String</dataType>
        <expression>IF(OR(LEFT({!$Record__Prior.OwnerId},3) = &quot;00G&quot;, LEFT({!$Record.OwnerId},3) = &quot;00G&quot;) , {!$User.Id} , {!$Record.OwnerId} )</expression>
    </formulas>
    <formulas>
        <name>AssignedToId</name>
        <dataType>String</dataType>
        <expression>IF(OR(BEGINS({!$Record.OwnerId},&apos;00G&apos;), AND(BEGINS({!$Record.OwnerId},&apos;005&apos;),{!$Record.Owner:User.IsActive} = FALSE)),{!$User.Id},{!$Record.OwnerId})</expression>
    </formulas>
    <formulas>
        <name>CloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY () + 30</expression>
    </formulas>
    <formulas>
        <name>DueDate_1Year</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(),12)</expression>
    </formulas>
    <formulas>
        <name>DueDate_2Years</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(),24)</expression>
    </formulas>
    <formulas>
        <name>DueDate_6Months</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS(TODAY(),6)</expression>
    </formulas>
    <formulas>
        <name>PriceBookName</name>
        <dataType>String</dataType>
        <expression>IF (
ISPICKVAL({!$Record.CurrencyIsoCode},&quot;IDR&quot;),&quot;Indonesia Price Book&quot;,
IF(ISPICKVAL({!$Record.CurrencyIsoCode},&quot;PHP&quot;),&quot;Philippines Price Book&quot;,
IF(ISPICKVAL({!$Record.CurrencyIsoCode},&quot;SGD&quot;),&quot;SGD Price Book&quot;,
&quot;USD Price Book&quot;
)
)
)</expression>
    </formulas>
