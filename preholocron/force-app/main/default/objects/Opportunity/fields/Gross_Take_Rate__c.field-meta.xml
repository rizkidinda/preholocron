<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gross_Take_Rate__c</fullName>
    <description>Estimated monthly gross take rate on parent opportunity level</description>
    <formula>IF(! ISBLANK(Addressable_Merchant_TPV_Monthly__c) , (Addressable_Merchant_Revenue_Monthly__c /  Addressable_Merchant_TPV_Monthly__c),null)</formula>
    <label>Gross Take Rate ( % )</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
