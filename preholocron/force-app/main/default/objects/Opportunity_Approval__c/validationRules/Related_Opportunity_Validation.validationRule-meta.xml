<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Related_Opportunity_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
$User.Bypass_VR__c = FALSE,
 Opportunity__r.RecordType.Name != &apos;Parent Opportunity&apos;
)</errorConditionFormula>
    <errorDisplayField>Opportunity__c</errorDisplayField>
    <errorMessage>Please select Parent Opportunity</errorMessage>
</ValidationRule>
