    <active>true</active>
    <errorConditionFormula>OR(LOWER(juro__ObjectName__c) = &apos;account&apos;, LOWER(juro__ObjectName__c) = &apos;opportunity&apos;, LOWER(juro__ObjectName__c) = &apos;contact&apos;, LOWER(juro__ObjectName__c) = &apos;user&apos;)</errorConditionFormula>
